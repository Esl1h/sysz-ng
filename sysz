#!/usr/bin/env bash

set -o pipefail
shopt -s lastpipe
shopt -s extglob

export SHELL=bash

PROG=$(basename "$0")
SYSZ_VERSION=1.5.0
SYSZ_HISTORY=${SYSZ_HISTORY:-${XDG_CACHE_HOME:-~/.cache}/sysz/history}
declare -a STATES

# Fonte unica de verdade: alias -> comando canonical.
declare -a CMD_ALIASES=(
  "start"
  "stop"
  "r:re:restart"
  "reload"
  "s:stat:status"
  "en:enable"
  "d:dis:disable"
  "mask"
  "unmask"
  "c:cat"
  "ed:edit"
  "show"
  "j:journal"
  "f:follow"
)

declare -A CMD_MAP
for _entry in "${CMD_ALIASES[@]}"; do
  IFS=':' read -ra _aliases <<<"$_entry"
  _cmd=${_aliases[-1]}
  for _a in "${_aliases[@]}"; do
    CMD_MAP[$_a]=$_cmd
  done
done

_sysz_header() {
  local avail=$1 long medium short
  long='esc quit  tab select  ^s state  ^r reload  ? help'
  medium='esc quit  ^s state  ? help'
  short='^s state  ? help'

  if ((avail >= ${#long})); then
    printf '%s' "$long"
  elif ((avail >= ${#medium})); then
    printf '%s' "$medium"
  elif ((avail >= ${#short})); then
    printf '%s' "$short"
  else
    printf '%s' '? help'
  fi
}

export -f _sysz_header

_sysz_keys() {
  printf '%s\n' \
    'Keybindings:' \
    '  type          Filter the list. Space separates terms.' \
    '  TAB           Toggle selection.' \
    "  ctrl-v        Toggle 'cat' the unit in the preview window." \
    '  ctrl-s        Select states to match. Selection is reset.' \
    '  ctrl-r        Run daemon-reload. Selection is reset.' \
    '  ctrl-p        History previous.' \
    '  ctrl-n        History next.' \
    '  ?             Show keybindings.' \
    '  esc, ctrl-c   Quit.'
}

_sysz_help() {
  cat <<EOF
Usage: $PROG [OPTS...] [CMD] [-- ARGS...]

OPTS:
  -u, --user               Only show --user units
  --sys, --system          Only show --system units
  -s STATE, --state STATE  Only show units in STATE (repeatable)
  -V, --verbose            Print the systemctl command
  -v, --version            Print the version
  -h, --help               Print this message

CMD:
EOF
  for _entry in "${CMD_ALIASES[@]}"; do
    IFS=':' read -ra _a <<<"$_entry"
    printf '  %-22s systemctl %s <unit>\n' "${_a[*]// /, }" "${_a[-1]}"
  done
  cat <<EOF

History:  $SYSZ_HISTORY

Examples:
  $PROG -u                      User units
  $PROG --sys -s active stop    Stop an active system unit
  $PROG s -- -n100             Show status with 100 log lines
EOF

  exit 0
}

_sysz_run() {
  [[ $VERBOSE = true ]] && echo '>' "$@" >&2
  "$@" || return $?
}

_sysz_systemctl() {
  if [[ $EUID -ne 0 && $1 = --system ]]; then
    _sysz_run sudo systemctl "$@"
  else
    _sysz_run systemctl "$@"
  fi
}

_sysz_journalctl() {
  if [[ $1 = --user ]]; then
    _sysz_run journalctl --user-unit="$2" "${@:3}"
  elif [[ $EUID -ne 0 ]]; then
    _sysz_run sudo journalctl --unit="$2" "${@:3}"
  else
    _sysz_run journalctl --unit="$2" "${@:3}"
  fi
}

_sysz_manager() {
  case ${1%% *} in
    '[user]')
      echo --user
      ;;
    '[system]')
      echo --system
      ;;
    *)
      echo "ERROR: Unknown manager: $1" >&2
      exit 1
      ;;
  esac
}

_fzf_preview() {
  local MANAGER UNIT
  MANAGER=$(_sysz_manager "$1")
  UNIT=${1##* }

  if [[ $2 = cat || $UNIT = *@.* ]]; then
    SYSTEMD_COLORS=1 systemctl "$MANAGER" cat -- "$UNIT"
  else
    SYSTEMD_COLORS=1 systemctl "$MANAGER" status --no-pager -- "$UNIT"
  fi
  exit 0
}

# shellcheck disable=SC2034
_sysz_show() {
  local manager unit out
  manager=$(_sysz_manager "$1")
  unit=${1##* }

  out=$(_sysz_systemctl "$manager" show "$unit" \
    -p ActiveState -p LoadState -p UnitFileState -p CanReload --value)

  ACTIVE_STATE=$(sed -n '1p' <<<"$out")
  LOAD_STATE=$(sed -n '2p' <<<"$out")
  UNIT_FILE_STATE=$(sed -n '3p' <<<"$out")
  CAN_RELOAD=$(sed -n '4p' <<<"$out")
}

_sysz_stream() {
  local mode=$1 manager=$2
  shift 2
  local -a args=(
    --all
    --no-legend
    --full
    --plain
    --no-pager
    "${STATES[@]}"
    "$@"
  )

  {
    systemctl list-units "${args[@]}" | sed -e 's/^/L /'
    [[ $mode = unloaded ]] && systemctl list-unit-files "${args[@]}" | sed -e 's/^/F /'
  } | awk -v mgr="[$manager]" '
    {
      u = $2
      if ($1 == "L") {
        loaded[u] = 1
        line[u] = $0
        next
      }
      if ($1 == "F" && !(u in loaded) && !seen[u]++) {
        line[u] = $0
        next
      }
    }
    END {
      for (u in line) {
        s = line[u]
        if (s ~ / active /)    c = "\033[0;32m" u "\033[0m"
        else if (s ~ / failed /)    c = "\033[0;31m" u "\033[0m"
        else if (s ~ / not-found /) c = "\033[1;33m" u "\033[0m"
        else                        c = u
        if (u ~ /\.service$/)     n = (mgr == "[system]") ? 1 : 0
        else if (u ~ /\.timer$/)  n = (mgr == "[system]") ? 3 : 2
        else if (u ~ /\.socket$/) n = (mgr == "[system]") ? 5 : 4
        else if (mgr == "[user]") n = 6
        else                       n = 7
        type = u
        sub(/^.*\./, "", type)
        undashed = u
        gsub(/-/, "", undashed)
        print n type undashed, mgr, c
      }
    }
  '
}

# Sourcing exposes functions without running the tool or requiring fzf.
# The test suite relies on this.
[[ ${BASH_SOURCE[0]} != "$0" ]] && return 0

# 0.46.0 is the first release that exports $FZF_PROMPT.
MIN_FZF=0.46.0
if [[ "$(printf '%s\n' "$MIN_FZF" "$(fzf --version | cut -d' ' -f1)" | sort -V | head -n1)" != "$MIN_FZF" ]]; then
  echo "ERROR: fzf >= $MIN_FZF required" >&2
  echo "https://github.com/junegunn/fzf#upgrading-fzf" >&2
  exit 1
fi

[[ $EUID -eq 0 ]] && MANAGERS=(system) || MANAGERS=(user system)

while [[ -n $1 ]]; do
  case $1 in
    -u | --user)
      MANAGERS=(user)
      shift
      ;;
    --sys | --system)
      MANAGERS=(system)
      shift
      ;;
    -s | --state)
      STATES+=("--state=$2")
      shift 2
      ;;
    --state=*)
      STATES+=("$1")
      shift
      ;;
    -v | --version)
      echo "$PROG" $SYSZ_VERSION
      exit 0
      ;;
    -V | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      _sysz_help
      ;;
    *)
      break
      ;;
  esac
done

# Validacao de states: uma chamada so.
VALID_STATES=$(systemctl --state=help | grep -v ':')
for STATE in "${STATES[@]}"; do
  STATE="${STATE##*=}"
  [[ -z $STATE ]] && continue
  if ! grep -qx "$STATE" <<<"$VALID_STATES"; then
    echo "ERROR: Invalid state: $STATE" >&2
    exit 1
  fi
done

while [[ -n $1 ]]; do
  case $1 in
    _fzf_preview)
      shift
      _fzf_preview "$@"
      ;;
    _fzf_cat)
      shift
      _fzf_preview "$@" cat
      ;;
    _sysz_header)
      shift
      _sysz_header "$@"
      ;;
    h | help)
      _sysz_help
      ;;
    --)
      shift
      ARGS=("$@")
      break
      ;;
    -*)
      echo "ERROR: Unknown option: $1" >&2
      exit 1
      ;;
    *)
      CMD=${CMD_MAP[$1]:-$1}
      ;;
  esac
  shift
done

mkdir -p "$(dirname "$SYSZ_HISTORY")"
touch "$SYSZ_HISTORY"

_sysz_daemon_reload() {
  {
    [[ $EUID -ne 0 ]] && echo '[system] daemon-reload'
    echo '[user] daemon-reload'
  } |
    fzf \
      --multi \
      --no-info \
      --prompt="Reload: " |
    readarray -t RELOADS || exit $?

  for RELOAD in "${RELOADS[@]}"; do
    _sysz_systemctl "$(_sysz_manager "$RELOAD")" daemon-reload >&2
  done
}

_sysz_states() {
  systemctl --state=help |
    grep -v ':' |
    grep -v 'ing' |
    sort -u |
    grep -v '^$' |
    fzf \
      --multi \
      --prompt="States: " |
    readarray -t PICKED_STATES || exit $?

  [[ ${#PICKED_STATES[@]} -gt 0 ]] && STATES=()

  for STATE in "${PICKED_STATES[@]}"; do
    STATES+=("--state=$STATE")
  done
}

# Tabela data-driven para o menu de comandos.
# Formato: comando|cor|condicao|extra
# A condicao e avaliada com eval (strings literais do script).
declare -a CMDS_TABLE=(
  "status|||" "journal|||" "follow|||" "cat|||" "edit|||" "show|||"
  "restart|31|[[ \$ACTIVE_STATE = active ]]|"
  "start|32|[[ \$ACTIVE_STATE != active ]]|"
  "stop|31|[[ \$ACTIVE_STATE = active ]]|"
  "enable|32|[[ \$UNIT_FILE_STATE != enabled ]]|"
  "enable|32|[[ \$UNIT_FILE_STATE != enabled ]]|--now"
  "disable|31|[[ \$UNIT_FILE_STATE = enabled ]]|"
  "disable|31|[[ \$UNIT_FILE_STATE = enabled ]]|--now"
  "reload|37|[[ \$CAN_RELOAD = yes ]]|"
  "mask|31|[[ \$UNIT_FILE_STATE != masked && \$LOAD_STATE != masked ]]|"
  "unmask|32|[[ \$UNIT_FILE_STATE = masked || \$LOAD_STATE = masked ]]|"
)

while :; do
  {
    for MANAGER in "${MANAGERS[@]}"; do
      _sysz_stream loaded "$MANAGER" "--$MANAGER"
      _sysz_stream unloaded "$MANAGER" "--$MANAGER"
    done
  } |
    sort -bifu | cut -d' ' -f2- |
    fzf \
      --multi \
      --ansi \
      --expect=ctrl-r,ctrl-s \
      --history="$SYSZ_HISTORY" \
      --prompt="Units: " \
      --header 'loading...' \
      --bind "load,resize:transform-header:'${BASH_SOURCE[0]}' _sysz_header \\\$FZF_COLUMNS" \
      --bind "?:preview('${BASH_SOURCE[0]}' _sysz_keys)" \
      --bind "ctrl-v:transform:[[ ! \$FZF_PROMPT =~ CAT ]] && echo 'change-prompt(CAT )+preview(${BASH_SOURCE[0]} _fzf_preview {} cat)' || echo 'change-prompt(Units: )+preview(${BASH_SOURCE[0]} _fzf_preview {})'" \
      --bind 'focus:change-prompt(Units: )' \
      --preview="'${BASH_SOURCE[0]}' _fzf_preview {}" \
      --preview-window=right:50% |
    readarray -t PICKS

  KEY=${PICKS[0]}
  [[ $VERBOSE = true ]] && echo "KEY: $KEY" >&2
  UNITS=("${PICKS[@]:1}")

  case $KEY in
    ctrl-r)
      _sysz_daemon_reload
      continue
      ;;
    ctrl-s)
      _sysz_states
      continue
      ;;
  esac

  if [[ ${#UNITS[@]} -eq 0 ]]; then
    exit 1
  fi

  break
done

[[ $VERBOSE = true ]] && printf 'UNIT: %s\n' "${UNITS[@]}" >&2

declare -a CMDS
if [[ -n $CMD ]]; then
  CMDS=("$CMD")
else

  if [[ ${#UNITS[@]} -gt 1 ]]; then
    printf -v PREVIEW '%s\n' "${UNITS[@]}"
    PREVIEW_CMD="echo -n '$PREVIEW'"
    # shellcheck disable=SC2034
    # Used by eval in CMDS_TABLE conditions.
    MULTI=true
  else
    UNIT=${UNITS[0]}

    if [[ $UNIT = *@.* ]]; then
      read -r -p "$UNIT requires a parameter: " PARAM
      if [[ -z $PARAM ]]; then
        echo "ERROR: $UNIT requires a parameter"
        exit 1
      fi
      UNIT=${UNIT/\@/\@${PARAM}}
      UNITS[0]=$UNIT
    fi

    _sysz_show "$UNIT"
    PREVIEW_CMD="'${BASH_SOURCE[0]}' _fzf_preview '$UNIT'"
  fi

  fzf \
    --multi \
    --ansi \
    --no-info \
    --prompt="Commands: " \
    --preview="$PREVIEW_CMD" \
    --preview-window=80% < <(
      for row in "${CMDS_TABLE[@]}"; do
        IFS='|' read -r cmd color cond extra <<<"$row"
        # shellcheck disable=SC2086
        # Intentional: cond is a literal string from the script itself.
        [[ -n $cond ]] && ! eval "$cond" 2>/dev/null && continue
        if [[ -n $color ]]; then
          printf '\033[0;%sm%s\033[0m' "$color" "$cmd"
        else
          printf '%s' "$cmd"
        fi
        [[ -n $extra ]] && printf ' %s' "$extra"
        printf ' %s\n' "${ARGS[*]}"
      done
    ) |
    readarray -t CMDS || exit $?
fi

if [[ ${#CMDS[@]} -eq 0 ]]; then
  exit 1
fi

for PICK in "${UNITS[@]}"; do

  MANAGER=$(_sysz_manager "$PICK")
  UNIT=${PICK##* }

  for CMD in "${CMDS[@]}"; do
    _cmd=${CMD%% *}
    case $_cmd in
      journal | follow)
        [[ $_cmd = follow ]] && _flag=-xef || _flag=-xe
        _sysz_journalctl "$MANAGER" "$UNIT" "$_flag" "${ARGS[@]}"
        ;;
      status)
        # shellcheck disable=2086
        # Intentional word splitting: $CMD is a single word set by this script.
        SYSTEMD_COLORS=1 systemctl "$MANAGER" $CMD --no-pager "${ARGS[@]}" -- "$UNIT"
        ;;
      cat | show)
        _sysz_systemctl "$MANAGER" "$CMD" "${ARGS[@]}" -- "$UNIT" || exit $?
        ;;
      *)
        # shellcheck disable=2086
        # Intentional word splitting: $CMD is a single word set by this script.
        _sysz_systemctl "$MANAGER" $CMD "${ARGS[@]}" -- "$UNIT" || CODE=$?
        SYSTEMD_COLORS=1 systemctl "$MANAGER" status --no-pager -- "$UNIT"
        [[ ${#UNITS[@]} -eq 1 ]] && exit "${CODE:-0}"
        ;;
    esac
  done
done
