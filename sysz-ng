#!/usr/bin/env bash

set -o pipefail
shopt -s lastpipe
shopt -s extglob

export SHELL=bash

PROG=$(basename "$0")
SYSZ_VERSION=2.3.0
SYSZ_HISTORY=${SYSZ_HISTORY:-${XDG_CACHE_HOME:-~/.cache}/sysz/history}
SYSZ_SUDO=${SYSZ_SUDO:-sudo}
declare -a STATES
SYSZ_REMOTE=()
declare -a TYPES

# Denylist: units that are noise in normal operation.
# These are generated, transient, or boot-time units that are almost
# never managed manually. Use --all to disable.
declare -a SYSZ_DENYLIST=(
  '*.device'
  '*.slice'
  'session-*.scope'
  'init.scope'
  'user@*.service'
  'user-runtime-dir@*.service'
  'dbus-:*'
  'dbus-org.*'
  'systemd-fsck@*'
  'systemd-backlight@*'
  'systemd-cryptsetup@*'
  'blockdev@*.target'
  'dev-*'
  'sys-*'
)

# Fonte unica de verdade: alias -> comando canonical.
declare -a CMD_ALIASES=(
  "start"
  "stop"
  "r:re:restart"
  "reload"
  "s:stat:status"
  "en:enable"
  "d:dis:disable"
  "mask"
  "unmask"
  "c:cat"
  "ed:edit"
  "show"
  "j:journal"
  "f:follow"
)

declare -A CMD_MAP
for _entry in "${CMD_ALIASES[@]}"; do
  IFS=':' read -ra _aliases <<<"$_entry"
  _cmd=${_aliases[-1]}
  for _a in "${_aliases[@]}"; do
    CMD_MAP[$_a]=$_cmd
  done
done

# Terminal dimensions
_sysz_term_width() {
  local cols
  cols=$(tput cols 2>/dev/null) || cols=$(stty size 2>/dev/null | cut -d' ' -f2) || cols=80
  printf '%s' "$cols"
}

_sysz_preview_layout() {
  local width=$1
  if ((width < 80)); then
    printf 'bottom:40%%'
  elif ((width < 120)); then
    printf 'right:40%%'
  else
    printf 'right:50%%'
  fi
}

# Build the context line for the header.
# Shows: managers, remote host, active filters.
_sysz_header_context() {
  local ctx=''
  if ((${#MANAGERS[@]} == 1)); then
    ctx="[${MANAGERS[0]} only]"
  else
    ctx='[user+system]'
  fi
  if ((${#SYSZ_REMOTE[@]} > 0)); then
    local host
    for arg in "${SYSZ_REMOTE[@]}"; do
      if [[ $arg == --host=* ]]; then
        host=${arg#--host=}
        ctx+=" @${host}"
      elif [[ $arg == --machine=* ]]; then
        host=${arg#--machine=}
        ctx+=" M:${host}"
      fi
    done
  fi
  printf '%s' "$ctx"
}

_sysz_header() {
  local avail=$1
  local ctx
  ctx=$(_sysz_header_context)
  local full="esc quit  tab select  ^v cat  ^s state  ^r reload  ^e etc  ^a curated  ? help"
  local long='esc quit  tab select  ^v cat  ^s state  ^e etc  ^a curated  ? help'
  local medium='esc quit  ^s state  ^e etc  ^a curated  ? help'
  local short='^s state  ^e etc  ? help'

  # Two-line header when there is enough room.
  # Width is the longest line, not the total including \n.
  local ctx_len=${#ctx} full_len=${#full}
  local max_len
  ((ctx_len > full_len)) && max_len=$ctx_len || max_len=$full_len
  if ((avail >= max_len)); then
    printf '%s\n%s' "$ctx" "$full"
    return
  fi

  if ((avail >= ${#full})); then
    printf '%s' "$full"
  elif ((avail >= ${#long})); then
    printf '%s' "$long"
  elif ((avail >= ${#medium})); then
    printf '%s' "$medium"
  elif ((avail >= ${#short})); then
    printf '%s' "$short"
  else
    printf '%s' '? help'
  fi
}

export -f _sysz_header

# shellcheck disable=SC2288
# False positive: shellcheck misinterprets printf multi-line continuations.
_sysz_keys() {
  local k=$'\033[1;36m' d=$'\033[0m' h=$'\033[1m'
  printf '%s\n' \
    "${h}Keybindings:${d}" \
    "  ${k}type${d}          Filter the list. Space separates terms." \
    "  ${k}TAB${d}           Toggle selection." \
    "  ${k}ctrl-v${d}        Toggle 'cat' the unit in the preview window." \
    "  ${k}ctrl-s${d}        Select states to match. Selection is reset." \
    "  ${k}ctrl-r${d}        Run daemon-reload. Selection is reset." \
    "  ${k}ctrl-e${d}        Toggle admin-owned (etc) vs all units." \
    "  ${k}ctrl-a${d}        Toggle curated mode (hide immutable units)." \
    "  ${k}ctrl-t${d}        Toggle recent-first sort (by state-change time)." \
    "  ${k}ctrl-p${d}        History previous." \
    "  ${k}ctrl-n${d}        History next." \
    "  ${k}?${d}             Show/hide this help." \
    "  ${k}esc${d}, ${k}ctrl-c${d}   Quit."
}

_sysz_help() {
  cat <<EOF
A utility for using systemctl interactively via fzf.

Usage: $PROG [OPTS...] [CMD] [-- ARGS...]

OPTS:
  -u, --user               Only show --user units
  --sys, --system          Only show --system units
  -s STATE, --state STATE  Only show units in STATE (repeatable)
  -t TYPE, --type TYPE     Only show units of TYPE (repeatable)
  -a, --all                Show all units (disable filters)
  --failed                 Only show failed units (alias for -s failed)
  --mine, --etc            Only show units with fragments under /etc
  --curated                Only show manageable units (hide immutable)
  --recent                 Sort by most recent state change first
  -H HOST, --host HOST     Connect to remote host
  -M MACHINE, --machine MACHINE  Operate on local container
  --no-cache               Skip list-unit-files cache
  -V, --verbose            Print the systemctl command
  -v, --version            Print the version
  -h, --help               Print this message

Environment:
  SYSZ_SUDO                Privilege escalation command (default: sudo)
  SYSZ_FZF_OPTS            Extra fzf options
  SYSZ_HISTORY             History file path

CMD:
EOF
  for _entry in "${CMD_ALIASES[@]}"; do
    local _aliases _cmd
    IFS=':' read -ra _aliases <<<"$_entry"
    _cmd=${_aliases[-1]}
    printf -v _line '%s' "${_aliases[0]}"
    for ((i = 1; i < ${#_aliases[@]}; i++)); do
      _line+=", ${_aliases[$i]}"
    done
    printf '  %-22s systemctl %s <unit>\n' "$_line" "$_cmd"
  done
  cat <<EOF

History:  $SYSZ_HISTORY

Examples:
  $PROG                        Admin-owned units (default)
  $PROG -a                     All units, no filters
  $PROG -u -t service,timer    User services and timers
  $PROG --failed               Failed units only
  $PROG --sys -s active stop   Stop an active system unit
  $PROG s -- -n100             Show status with 100 log lines
EOF

  exit 0
}

_sysz_run() {
  [[ $VERBOSE = true ]] && echo '>' "$@" >&2
  "$@" || return $?
}

# Wrapper around fzf that injects SYSZ_FZF_OPTS before explicit flags.
# Intentional word splitting: SYSZ_FZF_OPTS may contain multiple fzf flags.
_sysz_fzf() {
  # shellcheck disable=SC2086
  fzf ${SYSZ_FZF_OPTS} "$@"
}

_sysz_systemctl() {
  if [[ $EUID -ne 0 && $1 = --system ]]; then
    _sysz_run "$SYSZ_SUDO" systemctl "${SYSZ_REMOTE[@]}" "$@"
  else
    _sysz_run systemctl "${SYSZ_REMOTE[@]}" "$@"
  fi
}

_sysz_journalctl() {
  if [[ $1 = --user ]]; then
    _sysz_run journalctl "${SYSZ_REMOTE[@]}" --user-unit="$2" "${@:3}"
  elif [[ $EUID -ne 0 ]]; then
    _sysz_run "$SYSZ_SUDO" journalctl "${SYSZ_REMOTE[@]}" --unit="$2" "${@:3}"
  else
    _sysz_run journalctl "${SYSZ_REMOTE[@]}" --unit="$2" "${@:3}"
  fi
}

_sysz_manager() {
  case ${1%% *} in
  '[user]')
    echo --user
    ;;
  '[system]')
    echo --system
    ;;
  *)
    echo "ERROR: Unknown manager: $1" >&2
    exit 1
    ;;
  esac
}

_fzf_preview() {
  local MANAGER UNIT
  MANAGER=$(_sysz_manager "$1")
  UNIT=${1##* }

  if [[ $2 = cat || $UNIT = *@.* ]]; then
    SYSTEMD_COLORS=1 systemctl "${SYSZ_REMOTE[@]}" "$MANAGER" cat -- "$UNIT"
  else
    SYSTEMD_COLORS=1 systemctl "${SYSZ_REMOTE[@]}" "$MANAGER" status --no-pager -- "$UNIT"
  fi
  exit 0
}

# shellcheck disable=SC2034
_sysz_show() {
  local manager unit out
  manager=$(_sysz_manager "$1")
  unit=${1##* }

  out=$(_sysz_systemctl "$manager" show "$unit" \
    -p ActiveState -p LoadState -p UnitFileState -p CanReload --value)

  ACTIVE_STATE=$(sed -n '1p' <<<"$out")
  LOAD_STATE=$(sed -n '2p' <<<"$out")
  UNIT_FILE_STATE=$(sed -n '3p' <<<"$out")
  CAN_RELOAD=$(sed -n '4p' <<<"$out")
}

# Compatibility wrappers for the test suite.
_sysz_colorize() {
  awk '
    / active /    {printf "\033[0;32m%s\033[0m\n", $1; next}
    / failed /    {printf "\033[0;31m%s\033[0m\n", $1; next}
    / not-found / {printf "\033[1;33m%s\033[0m\n", $1; next}
    {print $1}
  '
}

_sysz_sort() {
  awk '
    {
      mgr = $1
      unit_colored = $NF
      unit = unit_colored
      gsub(/\033[\[(][0-9;]*[@-n]/, "", unit)

      if (unit ~ /\.service$/)     n = (mgr == "[system]") ? 1 : 0
      else if (unit ~ /\.timer$/)  n = (mgr == "[system]") ? 3 : 2
      else if (unit ~ /\.socket$/) n = (mgr == "[system]") ? 5 : 4
      else if (mgr == "[user]")    n = 6
      else                         n = 7

      type = unit
      sub(/^.*\./, "", type)
      undashed = unit
      gsub(/-/, "", undashed)

      print n type undashed, mgr, unit_colored
    }
  ' | sort -bifu | cut -d' ' -f2-
}

_sysz_list() {
  local mode=$1
  shift
  local -a args=(
    --all
    --no-legend
    --full
    --plain
    --no-pager
    "${STATES[@]}"
    "$@"
  )
  if [[ $mode = loaded ]]; then
    systemctl "${SYSZ_REMOTE[@]}" list-units "${args[@]}" | _sysz_colorize
  else
    {
      systemctl "${SYSZ_REMOTE[@]}" list-units "${args[@]}" | sed -e 's/^/L /'
      systemctl "${SYSZ_REMOTE[@]}" list-unit-files "${args[@]}" | sed -e 's/^/F /'
    } | awk '
      $1 == "L" {loaded[$2] = 1; next}
      !($2 in loaded) && !seen[$2]++ {sub(/^F /, ""); print}
    ' | _sysz_colorize
  fi
}

_sysz_preview_pct() {
  if (($1 >= 160)); then
    echo 70
  elif (($1 >= 100)); then
    echo 60
  else
    echo 50
  fi
}

_sysz_header_width() {
  echo $(($1 * (100 - $2) / 100 - 5))
}

# Tier 2: units with a fragment or drop-in under /etc or user config.
# Cheap: one ls per directory, no D-Bus.
_sysz_admin_owned() {
  {
    ls /etc/systemd/system/ 2>/dev/null || true
    ls "${XDG_CONFIG_HOME:-$HOME/.config}"/systemd/user/ 2>/dev/null || true
  } | sed 's/\.d$//' | sort -u
}

# Tier 3: units that are actually manageable.
# Filters out units with properties that mean "do not touch":
# RefuseManualStart/Stop, Perpetual, Transient, or generated (SourcePath).
# Input: one unit name per line. Output: only the manageable ones.
_sysz_curated() {
  local -a units=()
  while IFS= read -r u; do
    [[ -n $u ]] && units+=("$u")
  done
  ((${#units[@]} == 0)) && return
  systemctl "${SYSZ_REMOTE[@]}" show \
    --property=Id,RefuseManualStart,RefuseManualStop,Perpetual,Transient,SourcePath \
    -- "${units[@]}" |
    awk -F= '
      BEGIN { RS=""; FS="\n" }
      {
        id=""; refuse=0; perpetual=0; transient=0; sourcepath=0
        for (i=1; i<=NF; i++) {
          if ($i ~ /^Id=/)        id=substr($i, 4)
          if ($i ~ /^RefuseManualStart=yes/) refuse=1
          if ($i ~ /^RefuseManualStop=yes/)  refuse=1
          if ($i ~ /^Perpetual=yes/)         perpetual=1
          if ($i ~ /^Transient=yes/)         transient=1
          if ($i ~ /^SourcePath=\//)         sourcepath=1
        }
        if (!refuse && !perpetual && !transient && !sourcepath && id != "") print id
      }
    '
}

# Sort units by StateChangeTimestampMonotonic descending (most recent first).
# Input: one unit name per line. Output: same names, reordered.
_sysz_recent_sort() {
  local -a units=()
  while IFS= read -r u; do
    [[ -n $u ]] && units+=("$u")
  done
  ((${#units[@]} == 0)) && return
  systemctl "${SYSZ_REMOTE[@]}" show \
    --property=Id,StateChangeTimestampMonotonic \
    -- "${units[@]}" |
    awk -F= '
      BEGIN { RS=""; FS="\n" }
      {
        id=""; ts=0
        for (i=1; i<=NF; i++) {
          if ($i ~ /^Id=/) id=substr($i, 4)
          if ($i ~ /^StateChangeTimestampMonotonic=/) ts=substr($i, 32)+0
        }
        if (id != "") printf "%020d %s\n", ts, id
      }
    ' |
    sort -rn | cut -d' ' -f2-
}

_sysz_cache_dir() {
  echo "${XDG_CACHE_HOME:-$HOME/.cache}/sysz"
}

_sysz_cache_key() {
  local mgr=$1
  local -a dirs
  if [[ $mgr = '[user]' ]]; then
    dirs=("$HOME/.config/systemd/user" /usr/lib/systemd/user /run/systemd/user)
  else
    dirs=(/etc/systemd/system /usr/lib/systemd/system /run/systemd/system)
  fi
  for d in "${dirs[@]}"; do
    [[ -d $d ]] && stat -c '%Y' "$d" 2>/dev/null || echo 0
  done | md5sum | cut -d' ' -f1
}

_sysz_stream() {
  local mode=$1 manager=$2
  shift 2
  local -a args=(
    --all
    --no-legend
    --full
    --plain
    --no-pager
    "${STATES[@]}"
    "$@"
  )

  {
    systemctl "${SYSZ_REMOTE[@]}" list-units "${args[@]}" | sed -e 's/^/L /'
    if [[ $mode = unloaded && ! $NO_CACHE = true ]]; then
      local cache_dir key_file cache_file
      cache_dir=$(_sysz_cache_dir)
      key_file="$cache_dir/units-$manager.mtime"
      cache_file="$cache_dir/units-$manager"
      mkdir -p "$cache_dir"
      local current_key
      current_key=$(_sysz_cache_key "$manager")
      if [[ -f $key_file && -f $cache_file && $(cat "$key_file") = "$current_key" ]]; then
        sed -e 's/^/F /' "$cache_file"
      else
        systemctl "${SYSZ_REMOTE[@]}" list-unit-files "${args[@]}" | tee "$cache_file" | sed -e 's/^/F /'
        echo "$current_key" >"$key_file"
      fi
    elif [[ $mode = unloaded ]]; then
      systemctl "${SYSZ_REMOTE[@]}" list-unit-files "${args[@]}" | sed -e 's/^/F /'
    fi
  } | awk -v mgr="[$manager]" '
    {
      u = $2
      if ($1 == "L") {
        loaded[u] = 1
        line[u] = $0
        next
      }
      if ($1 == "F" && !(u in loaded) && !seen[u]++) {
        line[u] = $0
        next
      }
    }
    END {
      for (u in line) {
        s = line[u]
        if (s ~ / active /)    c = "\033[0;32m" u "\033[0m"
        else if (s ~ / failed /)    c = "\033[0;31m" u "\033[0m"
        else if (s ~ / not-found /) c = "\033[1;33m" u "\033[0m"
        else                        c = u
        if (u ~ /\.service$/)     n = (mgr == "[system]") ? 1 : 0
        else if (u ~ /\.timer$/)  n = (mgr == "[system]") ? 3 : 2
        else if (u ~ /\.socket$/) n = (mgr == "[system]") ? 5 : 4
        else if (mgr == "[user]") n = 6
        else                       n = 7
        type = u
        sub(/^.*\./, "", type)
        undashed = u
        gsub(/-/, "", undashed)
        print n type undashed, u, mgr, c
      }
    }
  '
}

# Filter the stream output. Reads 4 fields: sort_key plain_unit mgr colored.
# Applies denylist (unless --all), mine filter, and curated filter.
_sysz_filter_stream() {
  local sort_key plain_unit mgr colored
  while read -r sort_key plain_unit mgr colored; do
    if [[ $NO_DENY != true ]]; then
      for glob in "${SYSZ_DENYLIST[@]}"; do
        # shellcheck disable=SC2053
        # Intentional glob matching: SYSZ_DENYLIST entries are globs.
        [[ $plain_unit == "$glob" ]] && continue 2
      done
    fi
    if [[ $FILTER_MODE = mine ]]; then
      [[ -z ${ADMIN_UNITS[$plain_unit]} ]] && continue
    fi
    if [[ $CURATED = true ]]; then
      [[ -z ${CURATED_UNITS[$plain_unit]} ]] && continue
    fi
    printf '%s %s %s\n' "$sort_key" "$mgr" "$colored"
  done
}

_sysz_prompt() {
  local badg=$'\033[1;33m' off=$'\033[0m'
  local badges=''
  [[ $CURATED = true ]] && badges+="${badg}[curated]${off} "
  [[ $RECENT = true ]] && badges+="${badg}[recent]${off} "
  [[ $FILTER_MODE = mine ]] && badges+="${badg}[etc]${off} "
  [[ $NO_DENY = true ]] && badges+="${badg}[all]${off} "
  printf '%sUnits: ' "$badges"
}

# Sourcing exposes functions without running the tool or requiring fzf.
# The test suite relies on this.
[[ ${BASH_SOURCE[0]} != "$0" ]] && return 0

# 0.46.0 is the first release that exports $FZF_PROMPT.
MIN_FZF=0.46.0
if [[ "$(printf '%s\n' "$MIN_FZF" "$(fzf --version | cut -d' ' -f1)" | sort -V | head -n1)" != "$MIN_FZF" ]]; then
  echo "ERROR: fzf >= $MIN_FZF required" >&2
  echo "https://github.com/junegunn/fzf#upgrading-fzf" >&2
  exit 1
fi

[[ $EUID -eq 0 ]] && MANAGERS=(system) || MANAGERS=(user system)

while [[ -n $1 ]]; do
  case $1 in
  -u | --user)
    MANAGERS=(user)
    shift
    ;;
  --sys | --system)
    MANAGERS=(system)
    shift
    ;;
  -s | --state)
    STATES+=("--state=$2")
    shift 2
    ;;
  --state=*)
    STATES+=("$1")
    shift
    ;;
  -v | --version)
    echo "$PROG" $SYSZ_VERSION
    exit 0
    ;;
  -V | --verbose)
    VERBOSE=true
    shift
    ;;
  --no-cache)
    NO_CACHE=true
    shift
    ;;
  -a | --all)
    FILTER_MODE=all
    NO_DENY=true
    shift
    ;;
  -t | --type)
    TYPES+=("--type=$2")
    shift 2
    ;;
  --type=*)
    TYPES+=("$1")
    shift
    ;;
  --failed)
    STATES+=("--state=failed")
    shift
    ;;
  --mine | --etc)
    FILTER_MODE=mine
    shift
    ;;
  --curated)
    CURATED=true
    shift
    ;;
  --recent)
    RECENT=true
    shift
    ;;
  -H | --host)
    SYSZ_REMOTE+=("--host=$2")
    shift 2
    ;;
  -M | --machine)
    SYSZ_REMOTE+=("--machine=$2")
    shift 2
    ;;
  -h | --help)
    _sysz_help
    ;;
  *)
    break
    ;;
  esac
done

# Validacao de states: uma chamada so.
VALID_STATES=$(systemctl --state=help | grep -v ':')
for STATE in "${STATES[@]}"; do
  STATE="${STATE##*=}"
  [[ -z $STATE ]] && continue
  if ! grep -qx "$STATE" <<<"$VALID_STATES"; then
    echo "ERROR: Invalid state: $STATE" >&2
    exit 1
  fi
done

# Default filter mode: mine (admin-owned), falling back to all if too few.
FILTER_MODE=${FILTER_MODE:-mine}
if [[ $FILTER_MODE = mine ]]; then
  declare -A ADMIN_UNITS
  while IFS= read -r _u; do
    [[ -n $_u ]] && ADMIN_UNITS[$_u]=1
  done < <(_sysz_admin_owned)
  if ((${#ADMIN_UNITS[@]} < 5)); then
    FILTER_MODE=all
  fi
fi

# Curated filter: pre-populate the set of manageable units.
# This is lazy: only built when --curated is active.
if [[ $CURATED = true ]]; then
  declare -A CURATED_UNITS
fi

while [[ -n $1 ]]; do
  case $1 in
  _fzf_preview)
    shift
    _fzf_preview "$@"
    ;;
  _fzf_cat)
    shift
    _fzf_preview "$@" cat
    ;;
  _sysz_header)
    shift
    _sysz_header "$@"
    ;;
  h | help)
    _sysz_help
    ;;
  --)
    shift
    ARGS=("$@")
    break
    ;;
  -*)
    echo "ERROR: Unknown option: $1" >&2
    exit 1
    ;;
  *)
    CMD=${CMD_MAP[$1]:-$1}
    ;;
  esac
  shift
done

mkdir -p "$(dirname "$SYSZ_HISTORY")"
touch "$SYSZ_HISTORY"

_sysz_daemon_reload() {
  {
    [[ $EUID -ne 0 ]] && echo '[system] daemon-reload'
    echo '[user] daemon-reload'
  } |
    _sysz_fzf \
      --multi \
      --no-info \
      --header-first \
      --header="esc quit  tab select" \
      --prompt="Reload: " |
    readarray -t RELOADS || exit $?

  for RELOAD in "${RELOADS[@]}"; do
    _sysz_systemctl "$(_sysz_manager "$RELOAD")" daemon-reload >&2
  done
}

_sysz_states() {
  systemctl --state=help |
    grep -v ':' |
    grep -v 'ing' |
    sort -u |
    grep -v '^$' |
    _sysz_fzf \
      --multi \
      --header-first \
      --header="esc quit  tab select" \
      --prompt="States: " |
    readarray -t PICKED_STATES || exit $?

  [[ ${#PICKED_STATES[@]} -gt 0 ]] && STATES=()

  for STATE in "${PICKED_STATES[@]}"; do
    STATES+=("--state=$STATE")
  done
}

# Tabela data-driven para o menu de comandos.
# Formato: comando|cor|condicao|extra
# A condicao e avaliada com eval (strings literais do script).
declare -a CMDS_TABLE=(
  "status|||" "journal|||" "follow|||" "cat|||" "edit|||" "show|||"
  "restart|31|[[ \$ACTIVE_STATE = active ]]|"
  "start|32|[[ \$ACTIVE_STATE != active ]]|"
  "stop|31|[[ \$ACTIVE_STATE = active ]]|"
  "enable|32|[[ \$UNIT_FILE_STATE != enabled ]]|"
  "enable|32|[[ \$UNIT_FILE_STATE != enabled ]]|--now"
  "disable|31|[[ \$UNIT_FILE_STATE = enabled ]]|"
  "disable|31|[[ \$UNIT_FILE_STATE = enabled ]]|--now"
  "reload|37|[[ \$CAN_RELOAD = yes ]]|"
  "mask|31|[[ \$UNIT_FILE_STATE != masked && \$LOAD_STATE != masked ]]|"
  "unmask|32|[[ \$UNIT_FILE_STATE = masked || \$LOAD_STATE = masked ]]|"
)

while :; do
  if [[ $CURATED = true ]]; then
    # Curated mode: two-pass filter.
    # First pass collects the stream and builds the curated set.
    # Second pass applies the curated filter before fzf.
    _stream_tmp=$(mktemp)
    # shellcheck disable=SC2064
    trap "rm -f '$_stream_tmp'" EXIT
    {
      for MANAGER in "${MANAGERS[@]}"; do
        _sysz_stream loaded "$MANAGER" "--$MANAGER" "${TYPES[@]}"
        _sysz_stream unloaded "$MANAGER" "--$MANAGER" "${TYPES[@]}"
      done
    } >"$_stream_tmp"

    # Build curated set from the filtered stream.
    CURATED_UNITS=()
    while IFS= read -r _u; do
      [[ -n $_u ]] && CURATED_UNITS[$_u]=1
    done < <(<"$_stream_tmp" _sysz_filter_stream | sort -bifu | cut -d' ' -f3- | awk '{print $NF}' | sort -u | _sysz_curated)

    <"$_stream_tmp" _sysz_filter_stream | sort -bifu | cut -d' ' -f2- |
      _sysz_fzf \
        --multi \
        --ansi \
        --expect=ctrl-r,ctrl-s,ctrl-e,ctrl-a,ctrl-t \
        --history="$SYSZ_HISTORY" \
        --prompt="$(_sysz_prompt)" \
        --header-first \
        --header="$(_sysz_header "$(_sysz_term_width)")" \
        --info=inline \
        --marker='▸ ' \
        --pointer='▸ ' \
        --separator='─' \
        --bind "?:preview('${BASH_SOURCE[0]}' _sysz_keys)" \
        --bind "ctrl-v:transform:[[ ! \$FZF_PROMPT =~ CAT ]] && echo 'change-prompt(CAT )+preview(${BASH_SOURCE[0]} _fzf_preview {} cat)' || echo 'change-prompt($(_sysz_prompt))+preview(${BASH_SOURCE[0]} _fzf_preview {})'" \
        --preview="'${BASH_SOURCE[0]}' _fzf_preview {}" \
        --preview-window="$(_sysz_preview_layout "$(_sysz_term_width)")" |
      readarray -t PICKS
  else
    _stream_tmp=$(mktemp)
    # shellcheck disable=SC2064
    trap "rm -f '$_stream_tmp'" EXIT
    {
      for MANAGER in "${MANAGERS[@]}"; do
        _sysz_stream loaded "$MANAGER" "--$MANAGER" "${TYPES[@]}"
        _sysz_stream unloaded "$MANAGER" "--$MANAGER" "${TYPES[@]}"
      done
    } |
      _sysz_filter_stream |
      sort -bifu | cut -d' ' -f2- >"$_stream_tmp"

    if [[ $RECENT = true ]]; then
      # Reorder by StateChangeTimestampMonotonic descending.
      _sorted_tmp=$(mktemp)
      # shellcheck disable=SC2064
      trap "rm -f '$_sorted_tmp'" EXIT
      while IFS= read -r _line; do
        _unit=${_line##* }
        _unit=${_unit//$'\033'\[*([0-9;])m/}
        printf '%s\n' "$_unit"
      done <"$_stream_tmp" | sort -u | _sysz_recent_sort >"$_sorted_tmp"
      # Reorder the original output by the sorted list.
      awk 'NR==FNR {order[$1]=NR; next} {
        u=$0
        gsub(/\033\[[0-9;]*m/, "", u)
        u=u
        sub(/^\[.*\] /, "", u)
        if (u in order) printf "%08d %s\n", order[u], $0
      }' "$_sorted_tmp" "$_stream_tmp" | sort | cut -d' ' -f2- >"${_stream_tmp}.sorted"
      mv "${_stream_tmp}.sorted" "$_stream_tmp"
    fi

    <"$_stream_tmp" _sysz_fzf \
      --multi \
      --ansi \
      --expect=ctrl-r,ctrl-s,ctrl-e,ctrl-a,ctrl-t \
      --history="$SYSZ_HISTORY" \
      --prompt="$(_sysz_prompt)" \
      --header-first \
      --header="$(_sysz_header "$(_sysz_term_width)")" \
      --info=inline \
      --marker='▸ ' \
      --pointer='▸ ' \
      --separator='─' \
      --bind "?:preview('${BASH_SOURCE[0]}' _sysz_keys)" \
      --bind "ctrl-v:transform:[[ ! \$FZF_PROMPT =~ CAT ]] && echo 'change-prompt(CAT )+preview(${BASH_SOURCE[0]} _fzf_preview {} cat)' || echo 'change-prompt($(_sysz_prompt))+preview(${BASH_SOURCE[0]} _fzf_preview {})'" \
      --preview="'${BASH_SOURCE[0]}' _fzf_preview {}" \
      --preview-window="$(_sysz_preview_layout "$(_sysz_term_width)")" |
      readarray -t PICKS
  fi

  KEY=${PICKS[0]}
  [[ $VERBOSE = true ]] && echo "KEY: $KEY" >&2
  UNITS=("${PICKS[@]:1}")

  case $KEY in
  ctrl-r)
    _sysz_daemon_reload
    continue
    ;;
  ctrl-s)
    _sysz_states
    continue
    ;;
  ctrl-e)
    if [[ $FILTER_MODE = mine ]]; then
      FILTER_MODE=all
    else
      FILTER_MODE=mine
      # Rebuild admin-owned set in case context changed
      ADMIN_UNITS=()
      while IFS= read -r _u; do
        [[ -n $_u ]] && ADMIN_UNITS[$_u]=1
      done < <(_sysz_admin_owned)
    fi
    continue
    ;;
  ctrl-a)
    if [[ $CURATED = true ]]; then
      CURATED=false
    else
      CURATED=true
    fi
    continue
    ;;
  ctrl-t)
    if [[ $RECENT = true ]]; then
      RECENT=false
    else
      RECENT=true
    fi
    continue
    ;;
  esac

  if [[ ${#UNITS[@]} -eq 0 ]]; then
    exit 1
  fi

  break
done

[[ $VERBOSE = true ]] && printf 'UNIT: %s\n' "${UNITS[@]}" >&2

declare -a CMDS
if [[ -n $CMD ]]; then
  CMDS=("$CMD")
else

  if [[ ${#UNITS[@]} -gt 1 ]]; then
    printf -v PREVIEW '%s\n' "${UNITS[@]}"
    PREVIEW_CMD="echo -n '$PREVIEW'"
    # shellcheck disable=SC2034
    # Used by eval in CMDS_TABLE conditions.
    MULTI=true
  else
    UNIT=${UNITS[0]}

    if [[ $UNIT = *@.* ]]; then
      TEMPLATE=${UNIT##* }
      PARAM=$(
        systemctl "${SYSZ_REMOTE[@]}" "$(_sysz_manager "$UNIT")" list-units --all --no-legend --no-pager --plain "$TEMPLATE@*" |
          awk '{print $1}' |
          sed "s/^${TEMPLATE}@//" |
          sort -u |
          _sysz_fzf \
            --print-query \
            --prompt="$TEMPLATE parameter: " \
            --header="esc new  tab select" |
          tail -n1
      )
      if [[ -z $PARAM ]]; then
        echo "ERROR: $UNIT requires a parameter" >&2
        exit 1
      fi
      UNIT=${UNIT/\@/\@${PARAM}}
      UNITS[0]=$UNIT
    fi

    _sysz_show "$UNIT"
    PREVIEW_CMD="'${BASH_SOURCE[0]}' _fzf_preview '$UNIT'"
  fi

  _sysz_fzf \
    --multi \
    --ansi \
    --header-first \
    --prompt="Commands: " \
    --header="esc quit  tab select  ? help" \
    --info=inline \
    --marker='▸ ' \
    --pointer='▸ ' \
    --separator='─' \
    --preview="$PREVIEW_CMD" \
    --preview-window=80% < <(
      for row in "${CMDS_TABLE[@]}"; do
        IFS='|' read -r cmd color cond extra <<<"$row"
        # shellcheck disable=SC2086
        # Intentional: cond is a literal string from the script itself.
        [[ -n $cond ]] && ! eval "$cond" 2>/dev/null && continue
        if [[ -n $color ]]; then
          printf '\033[0;%sm%s\033[0m' "$color" "$cmd"
        else
          printf '%s' "$cmd"
        fi
        [[ -n $extra ]] && printf ' %s' "$extra"
        printf ' %s\n' "${ARGS[*]}"
      done
    ) |
    readarray -t CMDS || exit $?
fi

if [[ ${#CMDS[@]} -eq 0 ]]; then
  exit 1
fi

CODE=0
for PICK in "${UNITS[@]}"; do
  MANAGER=$(_sysz_manager "$PICK")
  UNIT=${PICK##* }

  for CMD in "${CMDS[@]}"; do
    _cmd=${CMD%% *}
    case $_cmd in
    journal | follow)
      [[ $_cmd = follow ]] && _flag=-xef || _flag=-xe
      _sysz_journalctl "$MANAGER" "$UNIT" "$_flag" "${ARGS[@]}" || {
        _code=$?
        ((_code > CODE)) && CODE=$_code
      }
      ;;
    status)
      # shellcheck disable=2086
      # Intentional word splitting: $CMD is a single word set by this script.
      SYSTEMD_COLORS=1 systemctl "${SYSZ_REMOTE[@]}" "$MANAGER" $CMD --no-pager "${ARGS[@]}" -- "$UNIT" || {
        _code=$?
        ((_code > CODE)) && CODE=$_code
      }
      ;;
    cat | show)
      _sysz_systemctl "$MANAGER" "$CMD" "${ARGS[@]}" -- "$UNIT" || {
        _code=$?
        ((_code > CODE)) && CODE=$_code
      }
      ;;
    *)
      # shellcheck disable=2086
      # Intentional word splitting: $CMD is a single word set by this script.
      _sysz_systemctl "$MANAGER" $CMD "${ARGS[@]}" -- "$UNIT" || {
        _code=$?
        ((_code > CODE)) && CODE=$_code
      }
      SYSTEMD_COLORS=1 systemctl "${SYSZ_REMOTE[@]}" "$MANAGER" status --no-pager -- "$UNIT"
      ;;
    esac
  done
done

exit "$CODE"
